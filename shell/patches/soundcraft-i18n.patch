diff --git a/crates/ui-egui/src/i18n.rs b/crates/ui-egui/src/i18n.rs
new file mode 100644
index 0000000..71a5355
--- /dev/null
+++ b/crates/ui-egui/src/i18n.rs
@@ -0,0 +1,44 @@
+//! 界面多语言：OTools 插件壳（`otools-soundcraft` 的 `shell/`）在启动时把一张
+//! 「英文 → 目标语言」对照表装进来，之后所有**显示用**的字符串都过一遍 [`t`]。
+//!
+//! 设计约束（这是 OTools 移植层加进来的，上游没有界面语言偏好项）：
+//!
+//! - **只译 label，不译 path**。菜单树 `MenuNode { label, path }` 里 `path` 承载逻辑
+//!   （`command_for_path` / `ruler_id` / `mix_section_id` / `params_for` 全按 path 匹配），
+//!   `label` 只用于显示，所以包一层 [`t`] 是安全的；反过来说**任何**被 `match` / 查找
+//!   用来当键的字符串都不要包。
+//! - **查不到就原样返回英文**，所以没装表（不在 OTools 里、或宿主语言是英文）时零影响。
+//! - 表是 `&'static`，由外壳用 [`set_table`] 装入；语言可在运行中切换。
+//! - 表必须按英文键**有序**（二分查找），[`set_table`] 里有一句 `debug_assert` 兜底。
+
+use std::cell::Cell;
+
+/// 一张「英文 → 译文」对照表，按英文键有序。
+pub type Table = &'static [(&'static str, &'static str)];
+
+thread_local! {
+    /// 当前生效的对照表；`None` = 英文原文。
+    static TABLE: Cell<Option<Table>> = const { Cell::new(None) };
+}
+
+/// 装入（或换成 `None` 卸掉）一张按英文键有序的对照表。
+///
+/// 表由 `otools-soundcraft` 的 `scripts/gen-i18n.mjs` 从 `shell/i18n/zh-CN.tsv` 生成。
+pub fn set_table(table: Option<Table>) {
+    if let Some(t) = table {
+        debug_assert!(t.windows(2).all(|w| w[0].0 <= w[1].0), "i18n 表必须按英文键有序");
+    }
+    TABLE.with(|slot| slot.set(table));
+}
+
+/// 查表翻译；未命中（或没装表）时原样返回 `s`。
+#[inline]
+pub fn t(s: &str) -> &str {
+    TABLE.with(|slot| match slot.get() {
+        None => s,
+        Some(table) => match table.binary_search_by(|&(k, _)| k.cmp(s)) {
+            Ok(i) => table[i].1,
+            Err(_) => s,
+        },
+    })
+}
